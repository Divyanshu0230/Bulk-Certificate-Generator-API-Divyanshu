# Copy to .env to override defaults. The app runs without this file.

DATABASE_URL=sqlite:///./data/certificates.db
STORAGE_DIR=./storage/certificates
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_RECIPIENTS_PER_JOB=500
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=0.5

# Leave empty to disable authentication (handy for local review).
# When set, send it as the X-API-Key header. Verification stays public.
API_KEY=

# Comma-separated browser origins, or * for any origin.
CORS_ORIGINS=*
